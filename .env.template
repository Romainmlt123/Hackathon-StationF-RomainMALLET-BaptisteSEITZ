# ========================================
# HACKATHON STATION F - REALTIME VOICE AGENT
# Template de configuration
# ========================================
# Copiez ce fichier vers `.env` et remplissez vos clés API

# ========== API Keys (REQUIRED) ==========
MISTRAL_API_KEY=your_mistral_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ========== Server ==========
HOST=0.0.0.0
PORT=8765

# ========== Bot Behavior ==========
# Prompt système définissant le comportement de l'agent vocal
SYSTEM_PROMPT=Tu es un assistant vocal IA intelligent et professionnel pour l'accueil téléphonique d'une entreprise. Tu dois accueillir chaleureusement l'appelant, comprendre sa demande, et répondre de manière concise et claire. Ta réponse sera vocalisée, évite donc les emojis ou caractères spéciaux.

# Message de bienvenue initial
GREETING_PROMPT=Salue l'appelant et présente-toi brièvement.

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ========== Twilio (optional) ==========
# Si vous utilisez Twilio pour les appels entrants
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# URL publique de votre serveur (pour ngrok ou déploiement cloud)
# Exemple: wss://abc123.ngrok.io ou wss://votre-app.onrender.com
PUBLIC_WS_URL=

# ========== Backend API & Database ==========
# URL de l'API backend (utilisée par le voice agent pour logger les appels)
BACKEND_API_URL=http://localhost:8765

# Clé API pour authentifier les requêtes backend
API_KEY=your-secret-api-key-change-me

# Supabase configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
